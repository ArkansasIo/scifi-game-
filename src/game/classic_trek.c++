namespace classictrek { namespace {
int rnd(State& s,int n){s.rngState=s.rngState*1664525u+1013904223u;return n?int((s.rngState>>1)%unsigned(n)):0;}
bool valid(int x,int y){return x>=0&&x<64&&y>=0&&y<64;}
int gx(const State&s){return s.quadrantX*8+s.sectorX;} int gy(const State&s){return s.quadrantY*8+s.sectorY;}
Sector& at(State&s,int x,int y){return s.galaxy[y/8][x/8].sectors[y%8][x%8];}
const Sector& at(const State&s,int x,int y){return s.galaxy[y/8][x/8].sectors[y%8][x%8];}
int count(const State&s,int qx,int qy,Object o){int n=0;for(const auto&r:s.galaxy[qy][qx].sectors)for(const auto&v:r)if(v.object==o)++n;return n;}
void place(State&s,Object o){for(int i=0;i<4096;++i){int x=rnd(s,64),y=rnd(s,64);if(at(s,x,y).object==Object::Empty){at(s,x,y).object=o;if(o==Object::Klingon)at(s,x,y).hull=200;return;}}}
void position(State&s,int x,int y){s.quadrantX=x/8;s.quadrantY=y/8;s.sectorX=x%8;s.sectorY=y%8;at(s,x,y).object=Object::Enterprise;s.galaxy[s.quadrantY][s.quadrantX].explored=true;}
void enemyFire(State&s){int n=count(s,s.quadrantX,s.quadrantY,Object::Klingon),incoming=0;for(int i=0;i<n;++i)incoming+=12+rnd(s,18);const int absorbed=std::min(incoming,s.shields);s.shields-=absorbed;const int penetrating=incoming-absorbed;s.energy=std::max(0,s.energy-penetrating);if(penetrating>=15&&rnd(s,3)==0){const std::size_t system=static_cast<std::size_t>(rnd(s,5));s.damagedSystems[system]=true;}}
void checkEnd(State&s){if(s.klingonsRemaining<=0){s.gameOver=true;s.won=true;}else if(s.energy<=0||s.stardate>=s.deadline){s.gameOver=true;s.won=false;}}
std::string endMessage(const State&s){if(!s.gameOver)return {};return s.won?"All Klingon ships destroyed. The Federation is safe. Mission accomplished.\n":"Mission failed: energy depleted or the stardate deadline was reached.\n";}
std::string qlabel(const State&s){std::ostringstream o;o<<s.quadrantY+1<<'-'<<s.quadrantX+1;return o.str();}
}
void initialize(State&s,unsigned int seed){s=State{};s.rngState=seed?seed:1979u;for(auto&row:s.galaxy)for(auto&q:row)for(auto&r:q.sectors)for(auto&v:r)v.object=Object::Empty;for(int i=0;i<75;++i)place(s,Object::Star);for(int i=0;i<7;++i)place(s,Object::Klingon);for(int i=0;i<2;++i)place(s,Object::Starbase);for(int i=0;i<4096;++i){s.quadrantX=rnd(s,8);s.quadrantY=rnd(s,8);s.sectorX=rnd(s,8);s.sectorY=rnd(s,8);if(at(s,gx(s),gy(s)).object==Object::Empty)break;}at(s,gx(s),gy(s)).object=Object::Enterprise;s.galaxy[s.quadrantY][s.quadrantX].explored=true;}
std::string shortRangeScan(State&s){s.galaxy[s.quadrantY][s.quadrantX].explored=true;std::ostringstream o;o<<"SHORT-RANGE SCAN — quadrant "<<qlabel(s)<<"\n    1 2 3 4 5 6 7 8\n";for(int y=0;y<8;++y){o<<' '<<y+1<<"  ";for(int x=0;x<8;++x)o<<char(s.galaxy[s.quadrantY][s.quadrantX].sectors[y][x].object)<<' ';o<<'\n';}o<<"Legend: E Enterprise, K Klingon, B starbase, * star, . empty\n";return o.str();}
std::string longRangeScan(State&s){std::ostringstream o;o<<"LONG-RANGE SCAN — KBS counts (Klingons, Bases, Stars)\n";for(int dy=-1;dy<=1;++dy){for(int dx=-1;dx<=1;++dx){int x=s.quadrantX+dx,y=s.quadrantY+dy;if(x<0||x>=8||y<0||y>=8)o<<" ---";else o<<' '<<(s.galaxy[y][x].explored?' ':'?')<<count(s,x,y,Object::Klingon)<<count(s,x,y,Object::Starbase)<<count(s,x,y,Object::Star);}o<<'\n';}o<<"? marks a quadrant not yet visited.\n";return o.str();}
std::string status(const State&s){std::ostringstream o;o<<"STARSHIP STATUS\nStardate: "<<s.stardate<<" / "<<s.deadline<<"\nQuadrant: "<<qlabel(s)<<" Sector: "<<s.sectorY+1<<'-'<<s.sectorX+1<<"\nEnergy: "<<s.energy<<" Shields: "<<s.shields<<" Photon torpedoes: "<<s.torpedoes<<"\nKlingons remaining: "<<s.klingonsRemaining<<" Starbases remaining: "<<s.basesRemaining<<"\n";if(s.gameOver)o<<"Condition: "<<(s.won?"VICTORY":"MISSION FAILED")<<'\n';else o<<"Condition: "<<(count(s,s.quadrantX,s.quadrantY,Object::Klingon)?"RED ALERT":"GREEN")<<'\n';return o.str();}
std::string help(){return "Commands (case-insensitive):\n NAV dx dy    Move by sector offsets; quadrant crossing costs 25 energy and one stardate.\n WARP course factor  Warp by course (1=N, 2=NE, 3=E, 4=SE, 5=S, 6=SW, 7=W, 8=NW) and factor 1-8.\n SRS          Short-range scan.\n LRS          Long-range scan.\n DAM          Damage-control report.\n COM option   Library computer options 0-7.\n PHA energy   Fire phasers using energy.\n TOR row col  Fire a torpedo at a sector in this quadrant (1-8).\n TORC course  Fire along a course (1=N, 2=NE, 3=E, 4=SE, 5=S, 6=SW, 7=W, 8=NW).\n SHE energy   Transfer energy to shields.\n DOCK         Resupply and repair next to a starbase.\n STATUS       Show mission state.\n HELP         Show commands.\n QUIT         Abandon mission.\n";}
std::string execute(State&s,const std::string&command){if(s.gameOver)return endMessage(s)+"Mission is over; start a new mission to play again.\n";std::istringstream in(command);std::string v;in>>v;std::transform(v.begin(),v.end(),v.begin(),[](unsigned char c){return char(std::toupper(c));});if(v.empty())return "Enter a command. Type HELP for help.\n";if(v=="HELP")return help();if(v=="STATUS")return status(s);if(v=="SRS"){if(s.damagedSystems[0])return "Short-range sensors are damaged.\n";return shortRangeScan(s);}if(v=="LRS"){if(s.damagedSystems[0])return "Long-range sensors are damaged.\n";return longRangeScan(s);}if(v=="DAM"){static const char*names[]={"Sensors","Library computer","Phaser banks","Warp drive","Photon torpedo tubes"};std::ostringstream o;o<<"DAMAGE CONTROL REPORT\n";for(int i=0;i<5;++i)o<<"  "<<names[i]<<": "<<(s.damagedSystems[static_cast<std::size_t>(i)]?"DAMAGED":"operational")<<"\n";o<<"Energy "<<s.energy<<", shields "<<s.shields<<", torpedoes "<<s.torpedoes<<".\n";return o.str();}if(v=="COM"){if(s.damagedSystems[1])return "Library computer is damaged.\n";int option=-1;if(!(in>>option))return "Usage: COM option [x y]; options 0-7.\n";std::ostringstream o;o<<"LIBRARY COMPUTER\n";if(option==0){for(int qy=0;qy<8;++qy){for(int qx=0;qx<8;++qx){if(!s.galaxy[qy][qx].explored)o<<" ???";else o<<" "<<count(s,qx,qy,Object::Klingon)<<count(s,qx,qy,Object::Starbase)<<count(s,qx,qy,Object::Star);}o<<"\n";}return o.str();}if(option==1)return status(s);if(option==2){o<<"Torpedoes are aimed at a sector using TOR row col (coordinates 1-8).\n";return o.str();}if(option==3){int best=999,bx=-1,by=-1;for(int qy=0;qy<8;++qy)for(int qx=0;qx<8;++qx)for(int sy=0;sy<8;++sy)for(int sx=0;sx<8;++sx)if(s.galaxy[qy][qx].sectors[sy][sx].object==Object::Starbase){int dist=std::abs(qx*8+sx-gx(s))+std::abs(qy*8+sy-gy(s));if(dist<best){best=dist;bx=qx*8+sx;by=qy*8+sy;}}if(bx<0)return "No starbases remain.\n";o<<"Nearest starbase: quadrant "<<by/8+1<<"-"<<bx/8+1<<", sector "<<by%8+1<<"-"<<bx%8+1<<", Manhattan distance "<<best<<" sectors.\n";return o.str();}if(option==4){int dx=0,dy=0;if(!(in>>dx>>dy))return "Usage: COM 4 dx dy.\n";double distance=std::sqrt(double(dx*dx+dy*dy));int course=1;if(dx||dy){double angle=std::atan2(double(dx),-double(dy))*180.0/3.14159265358979323846;if(angle<0)angle+=360.0;course=1+int(std::round(angle/45.0))%8;}o<<"Course "<<course<<", distance "<<std::fixed<<std::setprecision(2)<<distance<<" sectors.\n";return o.str();}if(option==5){o<<"QUADRANT GRID: rows 1-8 run top-to-bottom; columns 1-8 run left-to-right.\n";o<<"Current quadrant "<<qlabel(s)<<".\n";return o.str();}if(option==6){o<<"TACTICAL COMPUTER — LOCAL KLINGON CONTACTS\n";int contacts=0;for(int y=0;y<8;++y)for(int x=0;x<8;++x)if(s.galaxy[s.quadrantY][s.quadrantX].sectors[y][x].object==Object::Klingon){++contacts;int range=std::max(std::abs(x-s.sectorX),std::abs(y-s.sectorY));o<<"  Contact "<<contacts<<": sector "<<y+1<<"-"<<x+1<<", range "<<range<<" sectors.\n";}if(!contacts)o<<"  No Klingon contacts in this quadrant.\n";return o.str();}if(option==7){int explored=0,knownK=0,knownB=0,knownStars=0;for(int qy=0;qy<8;++qy)for(int qx=0;qx<8;++qx)if(s.galaxy[qy][qx].explored){++explored;knownK+=count(s,qx,qy,Object::Klingon);knownB+=count(s,qx,qy,Object::Starbase);knownStars+=count(s,qx,qy,Object::Star);}o<<"GALACTIC INTELLIGENCE SUMMARY\n";o<<"Explored quadrants: "<<explored<<" / 64; unexplored: "<<64-explored<<".\n";o<<"Known contacts in explored space — Klingons: "<<knownK<<", starbases: "<<knownB<<", stars: "<<knownStars<<".\n";o<<"Mission-wide Klingons remaining: "<<s.klingonsRemaining<<"; starbases remaining: "<<s.basesRemaining<<".\n";return o.str();}return "Unknown computer option. Choose 0-7.\n";}if(v=="QUIT"){s.gameOver=true;return "Mission abandoned.\n";}
if(v=="WARP"){if(s.damagedSystems[3])return "Warp drive is damaged. Navigation unavailable.\n";int course=0,factor=0;if(!(in>>course>>factor)||course<1||course>8||factor<1||factor>8)return "Usage: WARP course factor (course 1-8, factor 1-8).\n";int dxs[]={0,1,1,1,0,-1,-1,-1};int dys[]={-1,-1,0,1,1,1,0,-1};int dx=dxs[course-1]*factor*8,dy=dys[course-1]*factor*8;int warpCost=factor*factor*8;if(warpCost>s.energy)return "Warp rejected: insufficient energy for this warp factor.\n";int distance=std::max(std::abs(dx),std::abs(dy));std::string result=execute(s,"NAV "+std::to_string(dx)+" "+std::to_string(dy));if(result.find("Navigation complete.")!=0)return result;int extra=warpCost-distance;if(extra>0)s.energy=std::max(0,s.energy-extra);checkEnd(s);if(s.gameOver&&result.find("Mission failed")==std::string::npos)result+=endMessage(s);return result;}
if(v=="NAV"){if(s.damagedSystems[3])return "Warp drive is damaged. Navigation unavailable.\n";int dx=0,dy=0;if(!(in>>dx>>dy)||(dx==0&&dy==0))return "Usage: NAV dx dy.\\n";int x=gx(s),y=gy(s),nx=x+dx,ny=y+dy;if(!valid(nx,ny))return "Navigation rejected: course leaves the galaxy.\\n";int steps=std::max(std::abs(dx),std::abs(dy));if(steps>s.energy)return "Navigation rejected: insufficient energy.\\n";int ax=std::abs(dx),ay=std::abs(dy),sx=(dx>0)-(dx<0),sy=(dy>0)-(dy<0),err=ax-ay;while(x!=nx||y!=ny){int e2=2*err;if(e2>-ay){err-=ay;x+=sx;}if(e2<ax){err+=ax;y+=sy;}if(!valid(x,y))return "Navigation halted at galaxy boundary.\\n";Object ob=at(s,x,y).object;if(ob==Object::Star||ob==Object::Starbase||ob==Object::Klingon)return "Navigation halted: course intersects an occupied sector.\\n";}at(s,gx(s),gy(s)).object=Object::Empty;s.energy-=steps;if(x/8!=s.quadrantX||y/8!=s.quadrantY){s.energy=std::max(0,s.energy-25);++s.stardate;}position(s,x,y);enemyFire(s);checkEnd(s);std::ostringstream o;o<<"Navigation complete. Quadrant "<<qlabel(s)<<", sector "<<s.sectorY+1<<'-'<<s.sectorX+1<<".\\n"<<endMessage(s);return o.str();}
if(v=="PHA"){if(s.damagedSystems[2])return "Phaser banks are damaged.\n";int p=0;if(!(in>>p)||p<=0)return "Usage: PHA energy.\n";if(p>s.energy)return "Phaser command rejected: insufficient energy.\n";int contacts=count(s,s.quadrantX,s.quadrantY,Object::Klingon);if(!contacts)return "No Klingon vessels in this quadrant.\n";s.energy-=p;const int share=p/contacts;int destroyed=0,damaged=0;std::ostringstream report;report<<"PHASER IMPACT REPORT\n";for(int y=0;y<8;++y)for(int x=0;x<8;++x){auto&z=s.galaxy[s.quadrantY][s.quadrantX].sectors[y][x];if(z.object!=Object::Klingon)continue;const int distance=std::max(1,std::max(std::abs(x-s.sectorX),std::abs(y-s.sectorY)));const int damage=(share*100)/distance;if(z.hull<=0)z.hull=200;z.hull=std::max(0,z.hull-damage);report<<"  Klingon at sector "<<y+1<<"-"<<x+1<<": "<<damage<<" damage, "<<z.hull<<" hull remaining.\n";if(z.hull==0){z.object=Object::Empty;--s.klingonsRemaining;++destroyed;}else ++damaged;}enemyFire(s);checkEnd(s);report<<"Energy committed: "<<p<<"; allocation per contact: "<<share<<".\nKlingons destroyed: "<<destroyed<<"; damaged but still active: "<<damaged<<".\n"<<endMessage(s);return report.str();}
if(v=="TORC"){if(s.damagedSystems[4])return "Photon torpedo tubes are damaged.\n";int course=0;if(!(in>>course)||course<1||course>8)return "Usage: TORC course (1-8).\n";if(s.torpedoes<=0)return "Photon torpedo tubes are empty.\n";--s.torpedoes;const int dxs[]={0,1,1,1,0,-1,-1,-1};const int dys[]={-1,-1,0,1,1,1,0,-1};int x=s.sectorX,y=s.sectorY;std::string result="Torpedo travelled out of the quadrant without a hit.\n";bool hit=false;for(int step=0;step<8;++step){x+=dxs[course-1];y+=dys[course-1];if(x<0||x>=8||y<0||y>=8)break;auto&target=s.galaxy[s.quadrantY][s.quadrantX].sectors[y][x];if(target.object==Object::Empty)continue;if(target.object==Object::Klingon){target.object=Object::Empty;--s.klingonsRemaining;result="Direct hit: Klingon vessel destroyed.\n";hit=true;break;}if(target.object==Object::Star){result="Torpedo struck a star and was lost.\n";hit=true;break;}if(target.object==Object::Starbase){target.object=Object::Empty;--s.basesRemaining;result="WARNING: starbase destroyed.\n";hit=true;break;}if(target.object==Object::Enterprise){continue;}}enemyFire(s);checkEnd(s);return result+endMessage(s);}
if(v=="TOR"){if(s.damagedSystems[4])return "Photon torpedo tubes are damaged.\n";int row=0,col=0;if(!(in>>row>>col)||row<1||row>8||col<1||col>8)return "Usage: TOR row col (1-8).\n";if(s.torpedoes<=0)return "Photon torpedo tubes are empty.\n";--s.torpedoes;auto&z=s.galaxy[s.quadrantY][s.quadrantX].sectors[row-1][col-1];std::string r;if(z.object==Object::Klingon){z.object=Object::Empty;--s.klingonsRemaining;r="Direct hit. Klingon destroyed.\n";}else if(z.object==Object::Star)r="Torpedo struck a star; no Klingon destroyed.\n";else if(z.object==Object::Starbase){z.object=Object::Empty;--s.basesRemaining;r="WARNING: starbase destroyed.\n";}else r="Torpedo missed.\n";enemyFire(s);checkEnd(s);return r+endMessage(s);}
if(v=="SHE"){int n=0;if(!(in>>n)||n<0)return "Usage: SHE energy.\n";if(n>s.energy)return "Shield transfer rejected: insufficient energy.\n";s.energy-=n;s.shields+=n;return "Shield reserve increased by "+std::to_string(n)+".\n";}
if(v=="DOCK"){bool near=false;for(int dy=-1;dy<=1;++dy)for(int dx=-1;dx<=1;++dx){int x=s.sectorX+dx,y=s.sectorY+dy;if((dx||dy)&&x>=0&&x<8&&y>=0&&y<8&&s.galaxy[s.quadrantY][s.quadrantX].sectors[y][x].object==Object::Starbase)near=true;}if(!near)return "Docking denied: move adjacent to a starbase.\n";s.energy=500;s.shields=0;s.torpedoes=3;s.damagedSystems.fill(false);return "Docking complete. Energy and torpedoes replenished.\n";}
return "Unknown command. Type HELP for commands.\n";}
void runMission(){State s;initialize(s,unsigned(std::time(nullptr)));std::cout<<"\n=== CLASSIC STAR TREK: TACTICAL MISSION ===\nDestroy all Klingons before stardate "<<s.deadline<<". Type HELP for commands.\n"<<status(s);std::string cmd;while(!s.gameOver){std::cout<<"TREK> ";if(!std::getline(std::cin,cmd))break;std::cout<<execute(s,cmd);}if(s.gameOver)std::cout<<endMessage(s);}
}
