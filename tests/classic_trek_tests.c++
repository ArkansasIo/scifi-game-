#include "game/classic_trek.h"
#include <cassert>
int main(){using namespace classictrek;State s;initialize(s,1979u);assert(s.energy==500&&s.torpedoes==3&&s.klingonsRemaining==7&&s.basesRemaining==2&&s.deadline==15);assert(shortRangeScan(s).find("SHORT-RANGE SCAN")!=std::string::npos);assert(shortRangeScan(s).find('E')!=std::string::npos);assert(longRangeScan(s).find("LONG-RANGE SCAN")!=std::string::npos);assert(execute(s,"BOGUS").find("Unknown command")!=std::string::npos);assert(execute(s,"DAM").find("DAMAGE CONTROL REPORT")!=std::string::npos);assert(execute(s,"COM 0").find("LIBRARY COMPUTER")!=std::string::npos);assert(execute(s,"COM 9").find("Unknown computer option")!=std::string::npos);assert(execute(s,"NAV 0 0").find("Usage")!=std::string::npos);assert(execute(s,"WARP 0 2").find("Usage")!=std::string::npos);assert(execute(s,"WARP 3 9").find("Usage")!=std::string::npos);assert(execute(s,"TORC 9").find("Usage")!=std::string::npos);assert(execute(s,"NAV 100 0").find("galaxy")!=std::string::npos);assert(execute(s,"TOR 0 9").find("Usage")!=std::string::npos);assert(execute(s,"SHE 9999").find("insufficient")!=std::string::npos);assert(s.energy==500);assert(status(s).find("Stardate: 0 / 15")!=std::string::npos);State nav;initialize(nav,42u);for(auto&row:nav.galaxy)for(auto&q:row){q.explored=true;for(auto&sectorRow:q.sectors)for(auto&sector:sectorRow)sector.object=Object::Empty;}nav.quadrantX=2;nav.quadrantY=2;nav.sectorX=1;nav.sectorY=3;nav.galaxy[2][2].sectors[3][1].object=Object::Enterprise;nav.klingonsRemaining=1;int before=nav.energy;assert(execute(nav,"WARP 3 2").find("Navigation complete.")!=std::string::npos);assert(nav.energy==before-32);assert(nav.sectorX==1&&nav.quadrantX==4);return 0;}
