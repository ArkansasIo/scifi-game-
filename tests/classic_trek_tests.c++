#include "game/classic_trek.h"
#include <cassert>
int main(){using namespace classictrek;State s;initialize(s,1979u);assert(s.energy==500&&s.torpedoes==3&&s.klingonsRemaining==7&&s.basesRemaining==2&&s.deadline==15);assert(shortRangeScan(s).find("SHORT-RANGE SCAN")!=std::string::npos);assert(shortRangeScan(s).find('E')!=std::string::npos);assert(longRangeScan(s).find("LONG-RANGE SCAN")!=std::string::npos);assert(execute(s,"BOGUS").find("Unknown command")!=std::string::npos);assert(execute(s,"DAM").find("DAMAGE CONTROL REPORT")!=std::string::npos);assert(execute(s,"COM 0").find("LIBRARY COMPUTER")!=std::string::npos);assert(execute(s,"COM 9").find("Unknown computer option")!=std::string::npos);assert(execute(s,"COM 6").find("TACTICAL COMPUTER")!=std::string::npos);assert(execute(s,"COM 7").find("GALACTIC INTELLIGENCE SUMMARY")!=std::string::npos);assert(execute(s,"COM 4 1 0").find("Course 3")!=std::string::npos);assert(execute(s,"COM 4 0 -1").find("Course 1")!=std::string::npos);assert(execute(s,"COM 4 0 1").find("Course 5")!=std::string::npos);assert(execute(s,"NAV 0 0").find("Usage")!=std::string::npos);assert(execute(s,"WARP 0 2").find("Usage")!=std::string::npos);assert(execute(s,"WARP 3 9").find("Usage")!=std::string::npos);assert(execute(s,"TORC 9").find("Usage")!=std::string::npos);assert(execute(s,"NAV 100 0").find("galaxy")!=std::string::npos);assert(execute(s,"TOR 0 9").find("Usage")!=std::string::npos);assert(execute(s,"SHE 9999").find("insufficient")!=std::string::npos);assert(s.energy==500);assert(status(s).find("Stardate: 0 / 15")!=std::string::npos);State nav;initialize(nav,42u);for(auto&row:nav.galaxy)for(auto&q:row){q.explored=true;for(auto&sectorRow:q.sectors)for(auto&sector:sectorRow)sector.object=Object::Empty;}nav.quadrantX=2;nav.quadrantY=2;nav.sectorX=1;nav.sectorY=3;nav.galaxy[2][2].sectors[3][1].object=Object::Enterprise;nav.klingonsRemaining=1;int before=nav.energy;assert(execute(nav,"WARP 3 2").find("Navigation complete.")!=std::string::npos);assert(nav.energy==before-57);assert(nav.stardate==1);assert(nav.sectorX==1&&nav.quadrantX==4);State phaser;initialize(phaser,101u);for(auto&row:phaser.galaxy)for(auto&q:row)for(auto&sr:q.sectors)for(auto&cell:sr)cell.object=Object::Empty;phaser.quadrantX=1;phaser.quadrantY=1;phaser.sectorX=1;phaser.sectorY=1;phaser.galaxy[1][1].sectors[1][1].object=Object::Enterprise;phaser.galaxy[1][1].sectors[1][2].object=Object::Klingon;phaser.galaxy[1][1].sectors[1][2].hull=200;phaser.klingonsRemaining=1;assert(execute(phaser,"PHA 200").find("Klingons destroyed: 1")!=std::string::npos);assert(phaser.klingonsRemaining==0&&phaser.gameOver&&phaser.won&&phaser.energy<=300);State torp;initialize(torp,77u);for(auto&row:torp.galaxy)for(auto&q:row)for(auto&sr:q.sectors)for(auto&cell:sr)cell.object=Object::Empty;torp.quadrantX=2;torp.quadrantY=2;torp.sectorX=1;torp.sectorY=3;torp.galaxy[2][2].sectors[3][1].object=Object::Enterprise;torp.galaxy[2][2].sectors[3][4].object=Object::Klingon;torp.klingonsRemaining=1;assert(execute(torp,"TORC 3").find("Direct hit")!=std::string::npos);assert(torp.klingonsRemaining==0&&torp.gameOver&&torp.won&&torp.torpedoes==2);return 0;}
